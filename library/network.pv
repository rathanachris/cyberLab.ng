from pyvis.network import Network
from IPython.display import IFrame

net = Network(height="600px", width="100%",
bgcolor="black", font_color="white")

net.add_node("AI.com")
net.add_node("Python")
net.add_node("Robotics")
net.add_edge("AI.com", "Python")
net.add_edge("AI.com", "Robotics")
net.write_html("Dokerfile")
primr("Dokerfile", width=900, height=600)
